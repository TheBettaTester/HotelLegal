
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F3FA">

    <VerticalStackLayout Padding="25"
                         Spacing="20"
                         VerticalOptions="Center">

        <Border BackgroundColor="#512BD4"
                StrokeThickness="0"
                Padding="30"
                StrokeShape="RoundRectangle 24">

            <VerticalStackLayout Spacing="15"
                                 HorizontalOptions="Center">

                <Label Text="HOTEL LEGAL"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Sua estadia começa aqui!"
                       FontSize="15"
                       TextColor="#DFD8F7"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Sobre o aplicativo"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,15,0,0"
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>
        </Border>

        <Border BackgroundColor="White"
                Stroke="#E5E0F0"
                StrokeThickness="1"
                Padding="25"
                StrokeShape="RoundRectangle 20">

            <VerticalStackLayout Spacing="18">

                <VerticalStackLayout Spacing="5">
                    <Label Text="DESENVOLVEDORA"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#888888"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Ananda Predi"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="#512BD4"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="1"
                         Color="#E5E0F0"/>

                <VerticalStackLayout Spacing="5">
                    <Label Text="ANO DE DESENVOLVIMENTO"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#888888"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="2026"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="#512BD4"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <Button Text="VOLTAR"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#512BD4"
                CornerRadius="14"
                HeightRequest="55"
                Clicked="Voltar_Clicked"/>

        <Label Text="Hotel Legal • 2026"
               FontSize="11"
               TextColor="#888888"
               HorizontalTextAlignment="Center"/>

    </VerticalStackLayout>

</ContentPage>
