
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Resumo"
             Title="Resumo da Reserva"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F7F5FC">

    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="18">

            <Label Text="HOTEL LEGAL"
                   FontFamily="KalamBold"
                   FontSize="30"
                   TextColor="#6C55B8"
                   HorizontalOptions="Center" />

            <Label x:Name="lblTituloResumo"
                   Text="Resumo da hospedagem"
                   FontSize="23"
                   FontAttributes="Bold"
                   TextColor="#3D315C"
                   HorizontalOptions="Center" />

            <Label x:Name="lblDescricaoResumo"
                   Text="Confira os dados antes de confirmar sua reserva."
                   FontSize="13"
                   TextColor="#777080"
                   HorizontalTextAlignment="Center" />

            <!-- Dados da reserva -->
            <Border BackgroundColor="White"
                    Stroke="#E9E2F5"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="12">

                    <Label x:Name="lblTituloReserva"
                           Text="SUA RESERVA"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#6C55B8" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoAcomodacao"
                               Text="Acomodação"
                               TextColor="#777080" />
                        <Label x:Name="lblAcomodacao"
                               Grid.Column="1"
                               FontAttributes="Bold"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoQuartos"
                               Text="Quantidade de quartos"
                               TextColor="#777080" />
                        <Label x:Name="lblQuartos"
                               Grid.Column="1"
                               FontAttributes="Bold"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoModalidade"
                               Text="Modalidade"
                               TextColor="#777080" />
                        <Label x:Name="lblModalidade"
                               Grid.Column="1"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoAdultos"
                               Text="Adultos"
                               TextColor="#777080" />
                        <Label x:Name="lblAdultos"
                               Grid.Column="1"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoCriancas"
                               Text="Crianças"
                               TextColor="#777080" />
                        <Label x:Name="lblCriancas"
                               Grid.Column="1"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoTotalHospedes"
                               Text="Total de hóspedes"
                               TextColor="#777080" />
                        <Label x:Name="lblTotalHospedes"
                               Grid.Column="1"
                               FontAttributes="Bold"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoCheckin"
                               Text="Check-in"
                               TextColor="#777080" />
                        <Label x:Name="lblCheckin"
                               Grid.Column="1"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid x:Name="linhaHorarioEntrada"
                          ColumnDefinitions="*,Auto"
                          IsVisible="False">
                        <Label x:Name="lblTextoHorarioEntrada"
                               Text="Horário de entrada"
                               TextColor="#777080" />
                        <Label x:Name="lblHorarioEntrada"
                               Grid.Column="1"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoCheckout"
                               Text="Check-out"
                               TextColor="#777080" />
                        <Label x:Name="lblCheckout"
                               Grid.Column="1"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid x:Name="linhaHorarioSaida"
                          ColumnDefinitions="*,Auto"
                          IsVisible="False">
                        <Label x:Name="lblTextoHorarioSaida"
                               Text="Horário de saída"
                               TextColor="#777080" />
                        <Label x:Name="lblHorarioSaida"
                               Grid.Column="1"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoNoites"
                               Text="Total de noites"
                               TextColor="#777080" />
                        <Label x:Name="lblNoites"
                               Grid.Column="1"
                               TextColor="#3D315C" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Valores -->
            <Border BackgroundColor="White"
                    Stroke="#E9E2F5"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="12">

                    <Label x:Name="lblTituloValores"
                           Text="VALORES"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#6C55B8" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoValorQuarto"
                               Text="Valor por quarto/noite"
                               TextColor="#777080" />
                        <Label x:Name="lblValorQuarto"
                               Grid.Column="1"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoQuantidadeQuartosValor"
                               Text="Quantidade de quartos"
                               TextColor="#777080" />
                        <Label x:Name="lblQuantidadeQuartosValor"
                               Grid.Column="1"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoDiaria"
                               Text="Total por noite"
                               FontAttributes="Bold"
                               TextColor="#3D315C" />
                        <Label x:Name="lblDiaria"
                               Grid.Column="1"
                               FontAttributes="Bold"
                               TextColor="#3D315C" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoFeriados"
                               Text="Noites com adicional"
                               TextColor="#777080" />
                        <Label x:Name="lblFeriados"
                               Grid.Column="1"
                               TextColor="#3D315C" />
                    </Grid>

                    <Label x:Name="lblAvisoAdicional"
                           Text="Feriados e períodos de férias recebem acréscimo de 30% por noite. Quando as duas condições coincidem, o adicional é aplicado apenas uma vez."
                           FontSize="12"
                           TextColor="#8A7DA5" />

                    <BoxView HeightRequest="1"
                             Color="#E9E2F5" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="lblTextoTotal"
                               Text="TOTAL DA HOSPEDAGEM"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#3D315C"
                               VerticalOptions="Center" />

                        <Label x:Name="lblTotal"
                               Grid.Column="1"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#6C55B8"
                               VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Button x:Name="btnVoltar"
                    Text="VOLTAR"
                    Clicked="Voltar_Clicked"
                    BackgroundColor="#E9E2FA"
                    TextColor="#6C55B8"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="52" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
